# Authentication: Use OAuth token for Claude Code CLI
# Generate at: https://console.anthropic.com/settings/oauth-tokens
CLAUDE_CODE_OAUTH_TOKEN=your_oauth_token_here

# Optional: Claude model to use (default: claude-opus-4-6)
ANTHROPIC_MODEL=claude-opus-4-6

# Optional: DeepSeek routing for implementation/build-fix phases only.
# When DEEPSEEK_BASE_URL is set, Phase 2 (implementation) and Phase 3 build-fix
# will run via DeepSeek's Anthropic-compatible endpoint.
# Planning, reflection, and commit-fix continue using Anthropic/Claude.
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: Overrides used only when DEEPSEEK_BASE_URL is set
DEEPSEEK_API_TIMEOUT_MS=600000
DEEPSEEK_DISABLE_NONESSENTIAL_TRAFFIC=1

# Optional: Maximum tokens the agent can consume per cycle (default: 200000)
MAX_TOKENS_PER_CYCLE=200000

# Optional: Maximum tool calls per cycle (default: 50)
MAX_TOOL_CALLS_PER_CYCLE=50

# Optional: GitHub integration for community interaction
# Generate a token at https://github.com/settings/tokens with "repo" scope
GITHUB_TOKEN=ghp_your_token_here

# Required if GITHUB_TOKEN is set — format: owner/repo
GITHUB_REPO=your-username/agentoak

# Optional: Base ROM URL for IPS patch generation
# Required for automatic release creation with ROM patches
BASE_ROM_URL=
